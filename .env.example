# Copy this file to .env.local and fill in real values.
# Do not commit .env.local.

# Public site URL used for metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://3d.felipeos.com

# Google Calendar appointment schedule link.
# If empty, booking CTAs silently fall back to mailto:felipe.mejia@spotz.pro.
NEXT_PUBLIC_BOOKING_URL=

# Admin login for /admin and tailored /cv/[slug] pages.
AUTH_SECRET=replace_with_a_random_secret
AUTH_USERNAME=admin
AUTH_PASSWORD=replace_with_a_strong_password

# Optional AI chat/TTS/CV personalization.
# Without OPENAI_API_KEY, chat uses the local fallback intent map.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional Supabase storage.
# Lead saves require NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SECRET_KEY.
# Public CV reads require NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
